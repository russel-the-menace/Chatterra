DATABASE_URL=postgresql://chatterra:chatterra@localhost:5432/chatterra
DATABASE_SSL=false
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_MODE=live
# Optional lower-cost model used for message translation and lightweight chat turns.
DEEPSEEK_LIGHT_MODEL=deepseek-chat
# Groq Whisper transcription for short mobile voice input. Keep this server-side only.
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# GROQ_TRANSCRIPTION_URL=https://api.groq.com/openai/v1/audio/transcriptions
# Optional Maya-only, self-hosted Qwen3-TTS voice messages. Requires a CUDA GPU service.
MAYA_VOICE_MESSAGES_ENABLED=false
QWEN_TTS_URL=http://localhost:8001
# Local development stores generated assistant audio here. Use object storage in production.
TTS_MEDIA_DIR=./data/voice
# Leave empty to serve audio from this backend at /media/voice.
TTS_PUBLIC_BASE_URL=
# Expo Push Service for background notifications. Tokens are registered by the mobile app.
PUSH_NOTIFICATIONS_ENABLED=false
# Optional override for tests or a compatible gateway.
# EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
PROACTIVE_SCHEDULER_ENABLED=true
PROACTIVE_SCHEDULER_INTERVAL_MS=30000
# Optional development-only timing overrides:
# PROACTIVE_MIN_DELAY_MINUTES=20
# PROACTIVE_MAX_DELAY_MINUTES=90
PORT=3000
