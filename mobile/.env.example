# Production API. Override this only when developing against another backend.
EXPO_PUBLIC_API_URL=https://api.feiwan.online

# Set after `eas init`. Required for iOS/Android remote push token registration.
EXPO_PUBLIC_EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID

# Remote push is disabled while using a free Apple Personal Team.
EXPO_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=false
